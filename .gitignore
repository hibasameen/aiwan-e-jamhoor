# ======================================================================
# Aiwan-e-Jamhoor — top-level .gitignore
# Keeps the app, code, docs and derived datasets under version control;
# excludes the large raw source archives (which exceed GitHub's limits and
# carry third-party terms) and local scratch. See data_inventory.md and
# DATA_LICENSE.md for where to obtain the excluded inputs.
# ======================================================================

# --- OS / editor ---
.DS_Store
**/.DS_Store
Thumbs.db
.ipynb_checkpoints/

# --- Python / Node ---
__pycache__/
*.pyc
.venv/
venv/
node_modules/
package-lock.json

# --- large raw ECP source archives (NOT redistributable here) ---
2018 Delimitation/
2023 Delimitation/
National Assembly 2024/
/National Assembly-*.zip
_samples/

# --- large third-party base layers (fetch from source; see data/ notes) ---
data/cod_PAK_ADM2.geojson
data/gb_PAK_ADM3.geojson
data/gadm36_PAK_adm3.json

# --- large intermediates (regenerated by the pipeline) ---
data/na_2023delim_true_partial.geojson
na_2018delim_raw.geojson
na_2024delim_raw.geojson
*_d3.geojson
out/

# --- superseded / redundant local copies ---
aiwan_e_jamhoor_map.html          # superseded by map.html
aiwan_careers_dynasties.html      # superseded by dynasties.html
aiwan-e-jamhoor-repo/             # the earlier curated sub-repo (now folded in here)
/aiwan_e_jamhoor_repo.zip
/aiwan-e-jamhoor-repo.zip
_to_delete/

# --- scratch ---
*.log
tmp/
