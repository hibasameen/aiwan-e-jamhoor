<style>
:root{
  color-scheme:light;
  --page:#eeece6; --surface:#f7f6f2; --surface-2:#e7e4dc;
  --ink:#12110f; --ink-2:#4a473f; --ink-3:#6a675e;
  --line:#cfcbc0; --line-2:#e3e0d7;
  --green:#14523a; --green-2:#1e6a49; --gold:#b8912f; --gold-2:#c9a13f; --cream:#f2efe6;
  --hatch:#cfcbc0;
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#12130f; --surface:#1a1b17; --surface-2:#24251f;
  --ink:#f3f1e9; --ink-2:#c7c3b6; --ink-3:#918d80;
  --line:#33342c; --line-2:#2a2b23;
  --green:#4f9e78; --green-2:#3f8a66; --gold:#cba43f; --gold-2:#d8b451; --cream:#f2efe6;
  --hatch:#3a3b32;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--page);color:var(--ink);font-family:Archivo,system-ui,sans-serif;font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:var(--green);text-decoration:none}
.mono{font-family:'Space Mono',monospace}
/* shell header */
header.shell{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}
.shell-in{max-width:1400px;margin:0 auto;padding:13px 32px;display:flex;align-items:center;gap:24px}
.brand{display:flex;align-items:center;gap:13px;cursor:pointer}
.brand .mk{width:38px;height:38px;color:var(--green);flex:none}
.brand .wm{font-family:'EB Garamond',serif;font-size:23px;line-height:1.05;color:var(--ink)}
.brand .wm .ur{font-family:'Noto Nastaliq Urdu',serif;font-size:17px;color:var(--gold);margin-inline-start:8px;vertical-align:2px}
.brand .sub{font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);margin-top:1px}
nav.main{display:flex;gap:2px;margin-left:6px}
nav.main a{background:transparent;color:var(--ink-2);font:600 13.5px Archivo,sans-serif;padding:8px 14px;border-radius:2px;cursor:pointer}
nav.main a:hover{background:var(--surface-2);color:var(--ink)}
nav.main a.on{background:var(--ink);color:var(--page)}
.spacer{flex:1}
.hdr-tools{display:flex;align-items:center;gap:8px}
input[type=search]{background:var(--page);border:1px solid var(--line);border-radius:2px;padding:8px 12px;font:400 13.5px/1 'Space Mono',monospace;color:var(--ink);width:190px}
input[type=search]:focus{outline:none;border-color:var(--green)}
.icon-btn{width:34px;height:34px;border:1px solid var(--line);background:var(--page);color:var(--ink-2);border-radius:2px;cursor:pointer;font-size:15px}
/* map layout */
main{max-width:1400px;margin:0 auto;padding:20px 32px 60px}
.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:14px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:2px;overflow:hidden;background:var(--surface)}
.seg button{border:0;background:transparent;color:var(--ink-2);font:600 13px/1 'Space Mono',monospace;padding:9px 16px;cursor:pointer}
.seg.arch button{font-family:Archivo,sans-serif}
.seg button.on{background:var(--ink);color:var(--page)}
.mode-note{font-size:12.5px;color:var(--ink-3);max-width:52ch;line-height:1.45}
.tbtn{border:1px solid var(--line);background:var(--surface);color:var(--ink-2);font:600 13px Archivo,sans-serif;padding:9px 14px;border-radius:2px;cursor:pointer}
.tbtn.on{background:var(--ink);color:var(--page)}
.map-wrap{display:flex;gap:16px;align-items:start}
.map-card{flex:1.6;background:var(--surface);border:1px solid var(--line);border-radius:3px;position:sticky;top:78px;min-width:0;padding:6px}
#map{width:100%;height:664px;display:block}
#map .cst{cursor:pointer;vector-effect:non-scaling-stroke}
.estat{display:grid;grid-template-columns:repeat(2,1fr);gap:10px 14px;margin:12px 0 14px}
.estat div span{display:block;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3)}
.estat div b{font-family:'Space Mono',monospace;font-size:15px;font-weight:700;color:var(--ink)}
.esum{font-size:12.8px;line-height:1.62;color:var(--ink-2);margin:0 0 12px}
.eq{border-left:2px solid var(--gold);padding:0 0 0 11px;margin:11px 0}
.eq .qt{font-family:'EB Garamond',serif;font-size:14.5px;line-height:1.45;color:var(--ink)}
.eq .qw{font-size:11.5px;color:var(--ink-3);margin-top:3px}
.eq .qw a{color:var(--ink-3);text-decoration:underline;text-underline-offset:2px}
.emore{font-size:11.5px}
.emore a{text-decoration:underline;text-underline-offset:2px}
.elecband{margin-top:16px}
.elecband .estat{grid-template-columns:repeat(4,1fr);gap:10px 24px;margin:12px 0 20px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.elecband .ebody{display:grid;grid-template-columns:1.15fr 1fr;gap:40px;align-items:start}
.elecband .esum{font-size:13.4px;line-height:1.7;margin:0 0 12px}
.elecband .eq{margin:0 0 14px}
.elecband .eq:last-child{margin-bottom:0}
.zoombtns{position:absolute;top:16px;left:16px;display:flex;flex-direction:column;gap:3px}
.zoombtns button{width:29px;height:29px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:15px;border-radius:2px;cursor:pointer}
.delim{position:absolute;bottom:14px;left:16px;font-size:11.5px;color:var(--ink-3);background:var(--surface);padding:4px 8px;border:1px solid var(--line-2);border-radius:2px}
.citybtns{display:flex;flex-wrap:wrap;align-items:center;gap:4px}
.citybtns .clab{font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-3);margin-right:2px}
.citybtns button{border:1px solid var(--line);background:var(--surface);color:var(--ink-2);font:600 11px Archivo,sans-serif;padding:5px 9px;border-radius:2px;cursor:pointer}
.citybtns button:hover{background:var(--ink);color:var(--page)}
.side{flex:1;display:flex;flex-direction:column;gap:16px;min-width:330px;max-width:420px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:18px 20px}
.card .k{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);margin-bottom:12px}
.legend .lrow{display:grid;grid-template-columns:14px 1fr auto;gap:10px;align-items:center;padding:5px 4px;border-radius:2px;cursor:pointer;font-size:13.5px}
.legend .lrow:hover{background:var(--page)}
.legend .sw{width:12px;height:12px;border-radius:2px}
.legend .n{font-family:'Space Mono',monospace;font-weight:700}
.detail-empty{font-size:13.5px;color:var(--ink-3);line-height:1.6}
.dh{display:flex;align-items:baseline;gap:10px}
.dh .na{font-family:'Space Mono',monospace;font-size:22px;font-weight:700}
.dh .nm{font-family:'EB Garamond',serif;font-size:20px;color:var(--ink-2)}
.dwhere{font-size:12.5px;color:var(--ink-3);margin-top:2px}
.dmeta{display:flex;flex-wrap:wrap;gap:2px 20px;margin:14px 0 4px}
.dmeta .m{min-width:78px}
.dmeta .mk2{font-size:11px;color:var(--ink-3)}
.dmeta .mv{font-family:'Space Mono',monospace;font-size:14.5px}
.f47{font-size:12px;color:#8a5b00;background:#f6efdd;border:1px solid #e3d3a8;border-radius:2px;padding:8px 10px;margin:12px 0 0;line-height:1.5}
:root[data-theme="dark"] .f47{color:#e8c877;background:#2a2413;border-color:#4a3f1e}
.cand{margin-top:9px}
.cand .r1{display:flex;justify-content:space-between;gap:8px;font-size:13px;align-items:baseline}
.cand .nm{font-weight:600}
.cand .pt{color:var(--ink-3);font-size:12px}
.cand .vt{font-family:'Space Mono',monospace;font-size:12.5px;color:var(--ink-2);white-space:nowrap}
.cand .track{height:6px;background:var(--page);margin-top:4px}
.cand .fill{height:100%}
.hist{border-top:1px solid var(--line-2);margin-top:16px;padding-top:14px}
.hist .hrow{display:grid;grid-template-columns:44px 12px 1fr auto;gap:9px;align-items:center;padding:5px 3px;font-size:13px;cursor:pointer}
.hist .hrow:hover{background:var(--page)}
.hist .hy{font-family:'Space Mono',monospace;color:var(--ink-3)}
.hist .hsw{width:10px;height:10px;border-radius:2px}
.hist .hc{font-family:'Space Mono',monospace;font-size:12px;color:var(--ink-3)}
.note{font-size:11px;color:var(--ink-3);margin-top:8px;line-height:1.5}
table.tbl{width:100%;border-collapse:collapse;font-size:13px}
table.tbl th{text-align:left;font:600 11px Archivo,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);padding:10px 8px 8px;border-bottom:1px solid var(--line);cursor:pointer;white-space:nowrap;position:sticky;top:0;background:var(--surface)}
table.tbl td{padding:6px 8px;border-bottom:1px solid var(--line-2)}
table.tbl tr{cursor:pointer}
table.tbl tr:hover td{background:var(--page)}
.tswatch{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:7px}
#tablewrap{max-height:664px;overflow:auto;padding:2px 10px 10px;display:none}
#tip{position:fixed;pointer-events:none;background:#12110f;color:#f7f6f2;padding:7px 10px;border-radius:2px;font:400 12px/1.45 Archivo,sans-serif;max-width:280px;z-index:60;display:none}
@media (max-width:820px){
  .shell-in{flex-wrap:wrap;gap:12px 16px;padding:12px 18px}
  nav.main{order:3;width:100%;margin-left:0;overflow-x:auto}
  .hdr-tools .hdr-search{display:none}
  .map-wrap{flex-direction:column}.side{max-width:none}#map{height:520px}.map-card{position:relative;top:auto}.elecband .estat{grid-template-columns:repeat(2,1fr)}.elecband .ebody{grid-template-columns:1fr;gap:22px}
  main{padding:16px 16px 60px}
}
</style>
</head>
