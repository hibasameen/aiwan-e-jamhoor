<script>
const PARTY_CAT={'Pakistan Muslim League (Nawaz)':'PML-N','Pakistan Peoples Party Parliamentarians':'PPP','Pakistan Muslim League (Qaid-e-Azam)':'PML-Q','Independents':'IND','Muttahida Qaumi Movement':'MQM','Awami National Party':'ANP','Jamiat Ulema-e Islam (Fazl)':'JUI-F','Pakistan Muslim League (Functional)':'PML-F','Pakistan Tehreek-e-Insaf':'PTI','Pakistan Muslim League (N)':'PML-N','Independent':'IND','Muttahida Qaumi Movement Pakistan':'MQM','Muttahida Majlis-e-Amal Pakistan':'MMA','Pakistan Muslim League':'PML-Q','Pakistan Muslim League (Q)':'PML-Q','Balochistan Awami Party':'BAP','Jamiat Ulema-e-Islam (F)':'JUI-F','Istehkam-e-Pakistan Party':'IPP','Muttahidda Majlis-e-Amal Pakistan':'MMA','Haq Parast Group':'MQM','National Alliance':'National Alliance','IJI':'IJI','PDA':'PDA','HPG':'MQM','ANP':'ANP','JUI-F':'JUI-F','PPP':'PPP','PML-N':'PML-N','PNA':'PNA','Pakistan National Alliance':'PNA','PML-J':'PML-J','Pakistan Muslim League (Junejo)':'PML-J','IJM':'IJM','Islami Jamhoori Mahaz':'IJM','PAI':'PAI','Pakistan Awami Ittehad':'PAI','BNP':'BNP','JWP':'JWP','PPP-SB':'PPP-SB'};
const COLORS={'PML-N':'#006400','PML-Q':'#52b452','PPP':'#1c1c1c','IND':'#b7b3a8','MQM':'#c245b8','ANP':'#e34948','PTI':'#7a1f3d','JUI-F':'#c98500','MMA':'#c98500','PML-F':'#2a5bd7','BAP':'#5b7ba6','IPP':'#8a6d1a','National Alliance':'#6d4aa7','IJI':'#006400','PDA':'#1c1c1c','PNA':'#2a7d6f','PML-J':'#6bbf59','IJM':'#c98500','PAI':'#8a6d1a','BNP':'#5b7ba6','JWP':'#7d6bbf','PPP-SB':'#5a5a5a','Other':'#00a3c7'};
const DARK_OVR={'PPP':'#e4e1d8','PDA':'#e4e1d8','IND':'#8f8b80'};
const CAT_ORDER=['PML-N','PPP','PTI','PML-Q','IND','MQM','MMA','ANP','JUI-F','PML-F','BAP','IPP','IJI','PDA','National Alliance','PNA','PML-J','IJM','PAI','BNP','JWP','PPP-SB','Other'];
const YEARS={'1977':{geo:'200seat',delim:'1977 delimitation · reconstructed (approx)',seats:200,postponed:[],prev:null},'1985':{geo:'207seat85',delim:'1985 non-party · 207-seat delim · reconstructed (approx, source numbering)',seats:207,postponed:[],prev:null},'1988':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:null},'1990':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1988'},'1993':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1990'},'1997':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1993'},'2002':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-262','NA-263'],prev:null},'2008':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-37','NA-42','NA-119','NA-207'],prev:'2002'},'2013':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-38','NA-83','NA-254'],prev:'2008'},'2018':{geo:'2018',delim:'2018 delimitation',seats:272,postponed:['NA-60','NA-103'],prev:'2013'},'2024':{geo:'2024',delim:'2023 delimitation',seats:266,postponed:[],prev:'2018'}};
const YL=['1977','1985','1988','1990','1993','1997','2002','2008','2013','2018','2024'];
const R=window.RESULTS, G=window.GEOS, D90G=window.D90G, D90=window.D90, XW=window.XW, W=860, H=660;
const state={year:'2024',mode:'winner',filterCat:null,selected:null,selectedUnit:null,tableMode:false,sortKey:'na',sortAsc:true};

function isDark(){return document.documentElement.dataset.theme==='dark'||(!document.documentElement.dataset.theme&&matchMedia('(prefers-color-scheme: dark)').matches);}
const cat=p=>PARTY_CAT[p]||'Other';
function col(c){return (isDark()&&DARK_OVR[c])?DARK_OVR[c]:(COLORS[c]||COLORS.Other);}
const fmt=n=>n==null?'—':n.toLocaleString('en-US');
const pc=n=>n==null?'—':n.toFixed(1)+'%';

const svg=d3.select('#map'), gRoot=d3.select('#mapg');
const pathGen=d3.geoPath(); let cache={}, fittedGeo=null;
const projs={};
function outlines(y){const k='ol:'+y;if(!cache[k]){paths(y);const gp=projs[YEARS[y].geo];
  cache[k]=D90G.features.filter(f=>f.properties.y==='*'||f.properties.y===y)
    .map(f=>({u:f.properties.u,d:gp(f)}));}return cache[k];}
function paths(y){const Y=YEARS[y];const k=Y.geo; if(!cache[k]){const geo=G[k]; const proj=d3.geoMercator().fitExtent([[10,10],[W-10,H-10]],geo); const gp=d3.geoPath(proj); projs[k]=gp; cache[k]=geo.features.map(f=>({p:f.properties,d:gp(f)}));} return cache[k];}
const zoom=d3.zoom().scaleExtent([1,55]).on('zoom',e=>gRoot.attr('transform',e.transform));
svg.call(zoom);
document.getElementById('zin').onclick=()=>svg.transition().call(zoom.scaleBy,1.6);
document.getElementById('zout').onclick=()=>svg.transition().call(zoom.scaleBy,1/1.6);
document.getElementById('zreset').onclick=()=>svg.transition().call(zoom.transform,d3.zoomIdentity);
const CITIES=[['Karachi',[66.55,24.70,67.67,25.74]],['Lahore',[73.92,31.17,74.74,31.82]],
['Islamabad–Rawalpindi',[72.54,32.97,73.73,34.12]],['Faisalabad',[72.60,30.57,73.78,31.89]],
['Peshawar',[71.17,33.53,71.95,34.42]],['Quetta',[66.14,29.71,67.53,30.57]]];
function zoomCity(b){paths(state.year);const gp=projs[YEARS[state.year].geo];if(!gp)return;
  const pj=gp.projection(),p0=pj([b[0],b[3]]),p1=pj([b[2],b[1]]);
  const bw=Math.abs(p1[0]-p0[0])||1,bh=Math.abs(p1[1]-p0[1])||1;
  const cx=(p0[0]+p1[0])/2,cy=(p0[1]+p1[1])/2;
  const k=Math.max(1,Math.min(55,0.9*Math.min(W/bw,H/bh)));
  svg.transition().duration(650).call(zoom.transform,
    d3.zoomIdentity.translate(W/2,H/2).scale(k).translate(-cx,-cy));}
(function(){const el=document.getElementById('citybtns');if(!el)return;
  const lab=document.createElement('span');lab.className='clab';lab.textContent='Zoom to city';el.appendChild(lab);
  CITIES.forEach(c=>{const btn=document.createElement('button');btn.textContent=c[0];
    btn.setAttribute('aria-label','Zoom to '+c[0]);btn.onclick=()=>zoomCity(c[1]);el.appendChild(btn);});
  const all=document.createElement('button');all.textContent='Whole country';
  all.onclick=()=>svg.transition().duration(650).call(zoom.transform,d3.zoomIdentity);el.appendChild(all);})();
window.addEventListener('keydown',e=>{if(e.key!=='Escape')return;const a=document.activeElement;if(a&&/INPUT|SELECT|TEXTAREA/.test(a.tagName))return;svg.transition().duration(500).call(zoom.transform,d3.zoomIdentity);});

const tip=document.getElementById('tip');
function showTip(html,e){tip.innerHTML=html;tip.style.display='block';tip.style.left=Math.min(e.clientX+14,innerWidth-300)+'px';tip.style.top=Math.min(e.clientY+14,innerHeight-120)+'px';}
function hideTip(){tip.style.display='none';}

function totals(y){const t={},res=R[y]||{};for(const r of Object.values(res)){const c=cat(r.wp);t[c]=(t[c]||0)+1;}return CAT_ORDER.filter(c=>t[c]).map(c=>[c,t[c]]).sort((a,b)=>b[1]-a[1]);}

function renderMap(){
  const y=state.year, Y=YEARS[y], res=mapRes(y), prevRes=Y.prev?R[Y.prev]:null;
  const feats=paths(y);
  const sel=gRoot.selectAll('path.cst').data(feats,d=>d.p.na);
  sel.enter().append('path').attr('class','cst')
    .on('mousemove',onMove).on('mouseleave',hideTip)
    .on('click',(e,d)=>{const U=YEARS[state.year].unit;if(U==='proj'){const x=(XW[state.year]||{})[d.p.na];state.selectedUnit=x?x.src[0]:null;state.selected=null;}else if(U==='district'){state.selectedUnit=d.p.na;state.selected=null;}else{state.selected=d.p.na;}renderAll();})
    .merge(sel)
    .attr('d',d=>d.d).attr('fill',d=>fillFor(d,res,prevRes))
    .attr('stroke',d=>strokeFor(d)).attr('stroke-width',d=>swFor(d))
    .attr('stroke-dasharray',d=>d.p.confidence==='low'?'2.4 1.9':null)
    .attr('opacity',d=>dimFor(d,res,prevRes)?0.16:1);
  sel.exit().remove();
  let olg=gRoot.select('g.olg'); if(olg.empty())olg=gRoot.append('g').attr('class','olg').attr('pointer-events','none');
  const isP=Y.unit==='proj';
  const os=olg.selectAll('path').data(isP?outlines(y):[],d=>d.u);
  os.enter().append('path').merge(os)
    .attr('d',d=>d.d).attr('fill','none')
    .attr('stroke',isDark()?'#f3f1e9':'#12110f')
    .attr('stroke-width',d=>d.u===state.selectedUnit?1.9:0.85)
    .attr('stroke-opacity',d=>d.u===state.selectedUnit?0.95:0.5);
  os.exit().remove(); olg.raise();
}
const _mrc={};
function mapRes(y){const Y=YEARS[y];if(Y.unit==='proj')return XW[y]||{};if(Y.unit!=='district')return R[y]||{};
  if(!_mrc[y]){const d=D90[y]||{},o={};for(const u in d){if(!d[u].noPoll)o[u]={wp:d[u].wp,name:u,to:d[u].to};}_mrc[y]=o;}
  return _mrc[y];}
