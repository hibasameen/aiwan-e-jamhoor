const COLORS={'PML-N':'#006400','PML-Q':'#52b452','PPP':'#1c1c1c','IND':'#b7b3a8','MQM':'#c245b8','ANP':'#e34948','PTI':'#7a1f3d','JUI-F':'#c98500','MMA':'#c98500','PML-F':'#2a5bd7','BAP':'#5b7ba6','IPP':'#8a6d1a','National Alliance':'#6d4aa7','IJI':'#006400','PDA':'#1c1c1c','PNA':'#2a7d6f','PML-J':'#6bbf59','IJM':'#c98500','PAI':'#8a6d1a','BNP':'#5b7ba6','JWP':'#7d6bbf','PPP-SB':'#5a5a5a','Other':'#00a3c7'};
const DARK_OVR={'PPP':'#e4e1d8','PDA':'#e4e1d8','IND':'#8f8b80'};
const CAT_ORDER=['PML-N','PPP','PTI','PML-Q','IND','MQM','MMA','ANP','JUI-F','PML-F','BAP','IPP','IJI','PDA','National Alliance','PNA','PML-J','IJM','PAI','BNP','JWP','PPP-SB','Other'];
const YEARS={'1977':{geo:'200seat',delim:'1977 delimitation · reconstructed (approx)',seats:200,postponed:[],prev:null},'1985':{geo:'207seat85',delim:'1985 non-party · 207-seat delim · reconstructed (approx, source numbering)',seats:207,postponed:[],prev:null},'1988':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:null},'1990':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1988'},'1993':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1990'},'1997':{geo:'207seat',delim:'1985–1997 delimitation · map-traced',seats:207,postponed:[],prev:'1993'},'2002':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-262','NA-263'],prev:null},'2008':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-37','NA-42','NA-119','NA-207'],prev:'2002'},'2013':{geo:'2002',delim:'2002 delimitation',seats:272,postponed:['NA-38','NA-83','NA-254'],prev:'2008'},'2018':{geo:'2018',delim:'2018 delimitation',seats:272,postponed:['NA-60','NA-103'],prev:'2013'},'2024':{geo:'2024',delim:'2023 delimitation',seats:266,postponed:[],prev:'2018'}};
const YL=['1977','1985','1988','1990','1993','1997','2002','2008','2013','2018','2024'];
const R=window.RESULTS, G=window.GEOS, D90G=window.D90G, D90=window.D90, XW=window.XW, W=860, H=660;
const state={year:'2024',mode:'winner',filterCat:null,selected:null,selectedUnit:null,tableMode:false,sortKey:'na',sortAsc:true};

function isDark(){return document.documentElement.dataset.theme==='dark'||(!document.documentElement.dataset.theme&&matchMedia('(prefers-color-scheme: dark)').matches);}
const cat=p=>PARTY_CAT[p]||'Other';
function col(c){return (isDark()&&DARK_OVR[c])?DARK_OVR[c]:(COLORS[c]||COLORS.Other);}
const fmt=n=>n==null?'—':n.toLocaleString('en-US');
const pc=n=>n==null?'—':n.toFixed(1)+'%';

const svg=d3.select('#map'), gRoot=d3.select('#mapg');
const pathGen=d3.geoPath(); let cache={}, fittedGeo=null;
const projs={};
function outlines(y){const k='ol:'+y;if(!cache[k]){paths(y);const gp=projs[YEARS[y].geo];
  cache[k]=D90G.features.filter(f=>f.properties.y==='*'||f.properties.y===y)
    .map(f=>({u:f.properties.u,d:gp(f)}));}return cache[k];}
function paths(y){const Y=YEARS[y];const k=Y.geo; if(!cache[k]){const geo=G[k]; const proj=d3.geoMercator().fitExtent([[10,10],[W-10,H-10]],geo); const gp=d3.geoPath(proj); projs[k]=gp; cache[k]=geo.features.map(f=>({p:f.properties,d:gp(f)}));} return cache[k];}
const zoom=d3.zoom().scaleExtent([1,14]).on('zoom',e=>gRoot.attr('transform',e.transform));
svg.call(zoom);
document.getElementById('zin').onclick=()=>svg.transition().call(zoom.scaleBy,1.6);
document.getElementById('zout').onclick=()=>svg.transition().call(zoom.scaleBy,1/1.6);
document.getElementById('zreset').onclick=()=>svg.transition().call(zoom.transform,d3.zoomIdentity);

const tip=document.getElementById('tip');
function showTip(html,e){tip.innerHTML=html;tip.style.display='block';tip.style.left=Math.min(e.clientX+14,innerWidth-300)+'px';tip.style.top=Math.min(e.clientY+14,innerHeight-120)+'px';}
function hideTip(){tip.style.display='none';}

function totals(y){const t={},res=R[y]||{};for(const r of Object.values(res)){const c=cat(r.wp);t[c]=(t[c]||0)+1;}return CAT_ORDER.filter(c=>t[c]).map(c=>[c,t[c]]).sort((a,b)=>b[1]-a[1]);}

function renderMap(){
  const y=state.year, Y=YEARS[y], res=mapRes(y), prevRes=Y.prev?R[Y.prev]:null;
  const feats=paths(y);
  const sel=gRoot.selectAll('path.cst').data(feats,d=>d.p.na);
  sel.enter().append('path').attr('class','cst')
    .on('mousemove',onMove).on('mouseleave',hideTip)
    .on('click',(e,d)=>{const U=YEARS[state.year].unit;if(U==='proj'){const x=(XW[state.year]||{})[d.p.na];state.selectedUnit=x?x.src[0]:null;state.selected=null;}else if(U==='district'){state.selectedUnit=d.p.na;state.selected=null;}else{state.selected=d.p.na;}renderAll();})
    .merge(sel)
    .attr('d',d=>d.d).attr('fill',d=>fillFor(d,res,prevRes))
    .attr('stroke',d=>strokeFor(d)).attr('stroke-width',d=>swFor(d))
    .attr('stroke-dasharray',d=>d.p.confidence==='low'?'2.4 1.9':null)
    .attr('opacity',d=>dimFor(d,res,prevRes)?0.16:1);
  sel.exit().remove();
  let olg=gRoot.select('g.olg'); if(olg.empty())olg=gRoot.append('g').attr('class','olg').attr('pointer-events','none');
  const isP=Y.unit==='proj';
  const os=olg.selectAll('path').data(isP?outlines(y):[],d=>d.u);
  os.enter().append('path').merge(os)
    .attr('d',d=>d.d).attr('fill','none')
    .attr('stroke',isDark()?'#f3f1e9':'#12110f')
    .attr('stroke-width',d=>d.u===state.selectedUnit?1.9:0.85)
    .attr('stroke-opacity',d=>d.u===state.selectedUnit?0.95:0.5);
  os.exit().remove(); olg.raise();
}
const _mrc={};
function mapRes(y){const Y=YEARS[y];if(Y.unit==='proj')return XW[y]||{};if(Y.unit!=='district')return R[y]||{};
  if(!_mrc[y]){const d=D90[y]||{},o={};for(const u in d){if(!d[u].noPoll)o[u]={wp:d[u].wp,name:u,to:d[u].to};}_mrc[y]=o;}
  return _mrc[y];}
function fillFor(f,res,prevRes){const r=res[f.p.na],c=r?cat(r.wp):null;
  if(!r)return 'url(#hatch)';
  if(state.mode==='winner')return col(c);
  const pr=prevRes&&prevRes[f.p.na];
  return !pr?'#d9d6cd':(cat(pr.wp)===c?'#14523a':'#b8912f');
}
function strokeFor(f){if(f.p.na===state.selected||(f.p.unit&&f.p.na===state.selectedUnit))return isDark()?'#f3f1e9':'#12110f';return f.p.confidence==='low'?'#8d8a80':'var(--surface)';}
function swFor(f){return (f.p.na===state.selected||(f.p.unit&&f.p.na===state.selectedUnit))?1.6:(f.p.confidence==='low'?0.7:0.5);}
function dimFor(f,res,prevRes){if(!state.filterCat)return false;const r=res[f.p.na],c=r?cat(r.wp):null;
  if(state.mode==='winner')return !r||c!==state.filterCat;
  const pr=prevRes&&prevRes[f.p.na];const k=!r?'none':(!pr?'new':(cat(pr.wp)===c?'held':'turned'));return k!==state.filterCat;}
function onMove(e,d){const y=state.year,Y=YEARS[y],res=Y.unit==='district'?mapRes(y):(R[y]||{}),prevRes=Y.prev?R[Y.prev]:null;const na=d.p.na,r=res[na];
  if(Y.unit==='proj'){const x=(XW[y]||{})[na];let h=`<b>${na}</b> <span style="opacity:.65">2002 boundary</span>`;
    if(!x)h+='<br>No 1990s result covers this ground';
    else{const u=(D90[y]||{})[x.src[0]];
      h+=`<br>${x.src[0]} in ${y}: `+(u&&u.tally?u.tally.map(t=>`${cat(t[0])} ${t[1]}`).join(', '):cat(x.wp));
      h+=x.one?'<br><i>This seat sits inside that district</i>'
             :`<br><i>Spans ${x.n} districts — ${x.src.join(', ')} — shaded by the largest share (${x.pur}%)</i>`;}
    showTip(h,e);return;}
  if(Y.unit==='district'){const u=(D90[y]||{})[na];let h=`<b>${na}</b>`;
    if(!u||u.noPoll)h+='<br>No general-election poll in this area';
    else{h+=`<br>${u.seats} seat${u.seats===1?'':'s'} · `+u.tally.map(t=>`${cat(t[0])} ${t[1]}`).join(', ');
      if(u.to)h+=`<br>Turnout ${pc(u.to)}`;
      if(u.tied)h+='<br><i>Tied on seats — shaded by combined vote</i>';}
    showTip(h,e);return;}
  let h=`<b>${na}</b>${r?' · '+r.name:''}`;
  if(r){h+=`<br>${r.wn}<br>${cat(r.wp)} · ${fmt(r.wv)} votes (${pc(r.ws)})<br>Turnout ${pc(r.to)}`;
    if(state.mode==='change'){const pr=prevRes&&prevRes[na];h+=pr?`<br>${Y.prev}: ${cat(pr.wp)}`:`<br>No ${Y.prev} result for this number`;}}
  else h+='<br>Poll postponed on election day';
  showTip(h,e);}

function renderToolbar(){
  const ys=document.getElementById('yearseg');ys.innerHTML='';
  [...YL].reverse().forEach(y=>{const b=document.createElement('button');b.textContent=y;if(y===state.year)b.className='on';b.onclick=()=>{state.year=y;state.selected=null;state.selectedUnit=null;state.filterCat=null;renderAll();};ys.appendChild(b);});
  document.querySelectorAll('#modeseg button').forEach(b=>{b.classList.toggle('on',b.dataset.mode===state.mode);b.onclick=()=>{state.mode=b.dataset.mode;state.filterCat=null;renderAll();};});
  const Y=YEARS[state.year];
  const isD=Y.unit==='district'||Y.unit==='proj';
  document.querySelectorAll('#modeseg button').forEach(b=>{b.disabled=isD&&b.dataset.mode==='change';b.style.opacity=b.disabled?0.4:1;b.style.cursor=b.disabled?'not-allowed':'pointer';});
  if(isD&&state.mode!=='winner')state.mode='winner';
  document.getElementById('modenote').textContent = isD
    ? 'No constituency boundaries survive for the 1977 delimitation. '+state.year+' district results are projected onto the 2002 constituencies, apportioned by area where a seat spans more than one district. Heavy outlines mark the districts the results belong to. These seats did not exist in '+state.year+': this is not a record of how they voted.'
    : state.mode==='winner'
    ? 'Filled by the winning party. Dashed edges mark provisional 2024 boundaries; hatching marks a postponed poll. In 2024 PTI ran without its symbol: its candidates appear as IND, as the returns record them.'
    : (Y.prev? `Held or turned over against ${Y.prev}.`+((state.year==='2018'||state.year==='2024')?' This pair crosses a delimitation, so the comparison is between seat numbers, not the same ground.':'') : '2008 is the first election here, so there is nothing to compare it against.');
  document.getElementById('delim').textContent=Y.delim;
  const tb=document.getElementById('tablebtn');tb.classList.toggle('on',state.tableMode);
  document.getElementById('map').style.display=state.tableMode?'none':'block';
  document.getElementById('zoombtns').style.display=state.tableMode?'none':'flex';
  document.getElementById('tablewrap').style.display=state.tableMode?'block':'none';
}

function renderLegend(){
  const y=state.year,res=R[y]||{},Y=YEARS[y],prevRes=Y.prev?R[Y.prev]:null;
  document.getElementById('legendtitle').textContent = state.mode==='winner'?('Seats won · '+y):('Change vs '+(Y.prev||'—'));
  const el=document.getElementById('legend');el.innerHTML='';let rows;
  if(state.mode==='winner'){rows=totals(y).map(([c,n])=>[c,n,col(c),c]);}
  else{const cc={held:0,turned:0,new:0};for(const [na,r] of Object.entries(res)){const pr=prevRes&&prevRes[na];if(!pr)cc.new++;else if(cat(pr.wp)===cat(r.wp))cc.held++;else cc.turned++;}
    rows=[['Held by same party',cc.held,'#14523a','held'],['Turned over',cc.turned,'#b8912f','turned'],['No comparable result',cc.new,'#d9d6cd','new']];}
  rows.forEach(([label,n,c,key])=>{const row=document.createElement('div');row.className='lrow';
    row.style.opacity=(state.filterCat&&state.filterCat!==key)?0.34:1;
    row.innerHTML=`<span class="sw" style="background:${c}"></span><span>${label}</span><span class="n">${n}</span>`;
    row.onclick=()=>{state.filterCat=state.filterCat===key?null:key;renderAll();};el.appendChild(row);});
}

function renderDetail(){
  const y=state.year,res=R[y]||{},Y=YEARS[y],d=document.getElementById('detail');const na=state.selected,r=res[na];
  if((Y.unit==='district'||Y.unit==='proj')&&!na){const u=state.selectedUnit?(D90[y]||{})[state.selectedUnit]:null;
    if(!u){d.innerHTML='<div class="k">District</div><div class="detail-empty">Click anywhere for the district whose '+y+' result shades that ground, and the seats it contained. The shapes are 2002 constituencies; they did not exist in '+y+'.</div>';return;}
    let h=`<div class="dh"><span class="nm" style="font-size:19px">${state.selectedUnit}</span></div>`;
    if(u.noPoll){h+='<div class="detail-empty" style="margin-top:8px">No seat here polled on election day '+y+'.</div>';d.innerHTML=h;return;}
    const mt=[['Seats',u.seats],['Registered',fmt(u.reg)],['Turnout',pc(u.to)]];
    h+='<div class="dmeta">'+mt.map(([k2,v])=>`<div class="m"><div class="mk2">${k2}</div><div class="mv">${v}</div></div>`).join('')+'</div>';
    h+='<div class="hist" style="margin-top:4px">'+u.nas.map(x=>`<div class="hrow" data-na="${x.na}"><span class="mono" style="color:var(--ink-3)">${x.na}</span><span class="hsw" style="background:${col(cat(x.wp))}"></span><span>${x.wn}${x.shared?' <i style="color:var(--ink-3)">· shared seat</i>':''}</span><span class="mono" style="color:var(--ink-3)">${cat(x.wp)}</span></div>`).join('')+'</div>';
    if(u.tied)h+='<div class="note">No party won most of this district\u2019s seats; it is shaded by the larger combined winning vote.</div>';
    h+='<div class="note">Seats marked <i>shared</i> also covered a neighbouring district, and are counted in both.</div>';
    d.innerHTML=h;
    d.querySelectorAll('.hrow[data-na]').forEach(rw=>rw.onclick=()=>{state.selected=rw.dataset.na;renderAll();});
    return;}
  if(!na){d.innerHTML='<div class="k">Constituency</div><div class="detail-empty">Click a seat on the map, or type its number in the search box, for the full candidate list and the same seat number at every election since 2002.</div>';return;}
  if(!r){d.innerHTML=`<div class="mono" style="font-size:22px">${na}</div><div class="detail-empty" style="margin-top:8px">Polling was postponed here on election day ${y} and the seat was filled in a later supplementary poll. It is left out to keep the map strictly election-day results.</div>`;return;}
  const f=paths(y).find(x=>x.p.na===na); const maxv=r.cands.length?Math.max(...r.cands.map(c=>c.v||0)):1;
  const meta=[['Registered',fmt(r.reg)],['Turnout',pc(r.to)],['Margin',pc(r.mov)],['Candidates',r.nc]];
  if(r.ps)meta.push(['Polling stations',fmt(r.ps)]); if(r.rej!=null)meta.push(['Rejected',fmt(r.rej)]);
  let bn='';
  if(y==='2024'&&f){const p=f.p;bn=p.confidence==='low'?'Internal boundaries provisional — district edges exact, the lines between seats inferred.':p.confidence==='medium'?'Boundary from the published seat composition; the line inside a split tehsil is inferred.':(p.src&&p.src.indexOf('district-composition')===0?'Boundary exact — this seat is a whole district.':'Boundary digitised from the Commission delimitation sheet.');}
  else if(Y.unit==='proj')bn='The shape drawn is a 2002 constituency; this seat had different boundaries, which do not survive.';
  else if(f&&f.p.approx)bn='Boundary within district: approximate.';
  let html=`<div class="dh"><span class="na">${na}</span><span class="nm">${r.name} · ${r.prov}</span></div>`;
  if(f&&(f.p.dist||f.p.teh)&&Y.unit!=='proj')html+=`<div class="dwhere">${f.p.dist||''}${f.p.teh?' · '+f.p.teh:''}</div>`;
  html+='<div class="dmeta">'+meta.map(([k,v])=>`<div class="m"><div class="mk2">${k}</div><div class="mv">${v}</div></div>`).join('')+'</div>';
  if(r.f47w)html+=`<div class="f47">Form-47 on election day declared ${r.f47w.n} (${r.f47w.p}, ${fmt(r.f47w.v)} votes) the winner. The result shown reflects a later recount or tribunal revision.</div>`;
  html+='<div style="border-top:1px solid var(--line-2);margin-top:16px;padding-top:14px">';
  r.cands.forEach(c=>{const cc=cat(c.p);html+=`<div class="cand"><div class="r1"><span><span class="nm">${c.n}</span> <span class="pt">${c.p}</span></span><span class="vt">${fmt(c.v)}${c.s!=null?' · '+pc(c.s):''}</span></div><div class="track"><div class="fill" style="width:${maxv?Math.max(2,100*(c.v||0)/maxv):0}%;background:${col(cc)}"></div></div></div>`;});
  html+='</div>';
  html+='<div class="hist"><div class="k">This seat number, 1993–2024</div>';
  YL.forEach(yy=>{const h=R[yy][na];const wn=h?h.wn:(YEARS[yy].postponed.includes(na)?'poll postponed':'no such seat');const c=h?cat(h.wp):'';const ccol=h?col(cat(h.wp)):'#d9d6cd';
    html+=`<div class="hrow" data-y="${yy}" style="background:${yy===y?'var(--page)':'transparent'}"><span class="hy">${yy}</span><span class="hsw" style="background:${ccol}"></span><span style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis">${wn}</span><span class="hc">${c}</span></div>`;});
  html+='<div class="note">Seat numbers were re-cut in 2018 and again in 2023, so the same number is not the same territory across delimitations. Read this as the history of the number, not of the ground.</div></div>';
  if(bn)html+=`<div class="note">${bn}</div>`;
  d.innerHTML=html;
  d.querySelectorAll('.hrow').forEach(rw=>rw.onclick=()=>{state.year=rw.dataset.y;renderAll();});
}

function renderTable(){
  const y=state.year,res=R[y]||{};
  const cols=[['na','Seat'],['name','Name'],['prov','Province'],['wn','Winner'],['cat','Party'],['wv','Votes'],['ws','Share'],['to','Turnout'],['mov','Margin']];
  let rows=Object.entries(res).map(([na,x])=>({na,num:parseInt(na.replace('NA-','')),name:x.name,prov:x.prov,wn:x.wn,cat:cat(x.wp),color:col(cat(x.wp)),wv:x.wv,ws:x.ws,to:x.to,mov:x.mov}));
  const sk=state.sortKey==='na'?'num':state.sortKey;
  rows.sort((a,b)=>{const x=a[sk],y2=b[sk];const c=(x==null)-(y2==null)||(typeof x==='string'?String(x).localeCompare(String(y2)):x-y2);return state.sortAsc?c:-c;});
  let h='<table class="tbl"><thead><tr>'+cols.map(([k,l])=>`<th data-k="${k}">${l}${state.sortKey===k?(state.sortAsc?' ↑':' ↓'):''}</th>`).join('')+'</tr></thead><tbody>';
  rows.forEach(r=>{h+=`<tr data-na="${r.na}"><td class="mono">${r.na}</td><td>${r.name}</td><td style="color:var(--ink-3)">${r.prov}</td><td>${r.wn}</td><td><span class="tswatch" style="background:${r.color}"></span>${r.cat}</td><td class="mono" style="text-align:right">${fmt(r.wv)}</td><td class="mono" style="text-align:right">${pc(r.ws)}</td><td class="mono" style="text-align:right">${pc(r.to)}</td><td class="mono" style="text-align:right">${pc(r.mov)}</td></tr>`;});
  h+='</tbody></table>';
  const wrap=document.getElementById('tablewrap');wrap.innerHTML=h;
  wrap.querySelectorAll('th').forEach(th=>th.onclick=()=>{const k=th.dataset.k;if(state.sortKey===k)state.sortAsc=!state.sortAsc;else{state.sortKey=k;state.sortAsc=true;}renderTable();});
  wrap.querySelectorAll('tr[data-na]').forEach(tr=>tr.onclick=()=>{state.selected=tr.dataset.na;state.tableMode=false;renderAll();});
}

document.getElementById('tablebtn').onclick=()=>{state.tableMode=!state.tableMode;renderAll();};

function renderSearch(){const dl=document.getElementById('cst');dl.innerHTML='';const res=R[state.year]||{};for(const [na,r] of Object.entries(res)){const o=document.createElement('option');o.value=`${na} ${r.name}`;dl.appendChild(o);}}
function doSearch(v){if(!v)return;const na=v.trim().split(' ')[0].toUpperCase();const res=R[state.year]||{};if(res[na]||YEARS[state.year].postponed.includes(na)){state.selected=na;renderAll();return;}const hit=Object.entries(res).find(([k,r])=>(k+' '+r.name).toLowerCase().includes(v.toLowerCase()));if(hit){state.selected=hit[0];renderAll();}}
const hs=document.getElementById('hsearch');
hs.addEventListener('keydown',e=>{if(e.key==='Enter'){doSearch(hs.value);hs.value='';}});
hs.addEventListener('change',()=>{if(hs.value){doSearch(hs.value);hs.value='';}});

document.getElementById('theme').onclick=()=>{const cur=document.documentElement.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');const nx=cur==='dark'?'light':'dark';document.documentElement.dataset.theme=nx;try{localStorage.setItem('aej-theme',nx);}catch(e){}renderAll();};
try{const s=localStorage.getItem('aej-theme');if(s)document.documentElement.dataset.theme=s;}catch(e){}

const ELEC={"1977":{"date":"7 March 1977","polled":"200 of 200","postponed":"","turnout":"63%","cands":"649","tight":"15","summary":"Zulfikar Ali Bhutto's PPP won a sweeping majority, but the opposition Pakistan National Alliance alleged systematic rigging and launched a mass protest movement. On 5 July 1977 the army chief General Zia-ul-Haq seized power and imposed martial law; Bhutto was later tried and hanged. The result is widely regarded as manipulated, and a large number of PPP candidates \u2014 including Bhutto at Larkana \u2014 were returned unopposed. Boundaries shown here are reconstructed and approximate.","quotes":[]},"1985":{"date":"28 February 1985","polled":"207 of 207","postponed":"","turnout":"53%","cands":"1,065","tight":"47","summary":"A non-party election held by General Zia after a 1984 referendum extended his rule: candidates contested as individuals with no party labels, and the Movement for the Restoration of Democracy boycotted. The result was a National Assembly of independents, from which Muhammad Khan Junejo was appointed prime minister. Because there were no party tickets, every seat is shown in the neutral independent colour. Boundaries are reconstructed and approximate.","quotes":[]},"1988":{"date":"16 November 1988","polled":"207 of 207","postponed":"","turnout":"43%","cands":"1,186","tight":"55","summary":"The first party-based election after General Zia died in an August 1988 air crash. Benazir Bhutto's PPP won the most seats and she became prime minister \u2014 the first woman to head a modern Muslim-majority state. The anti-PPP Islami Jamhoori Ittehad alliance was formed with covert ISI backing, as the Supreme Court later found in the Asghar Khan case. Boundaries are reconstructed and approximate.","quotes":[]},"2008":{"date":"18 February 2008","polled":"268 of 272","postponed":"4 seats did not poll","turnout":"44%","cands":"2,180","tight":"62","summary":"Polling was pushed from 8 January to 18 February after Benazir Bhutto was assassinated on 27 December 2007; four seats, including the one she would have contested, did not poll on the day. The vote was run by an Election Commission appointed under Pervez Musharraf, with the judges dismissed in the November 2007 emergency still not restored. PTI, Jamaat-e-Islami and the rest of the APDM bloc boycotted. Pakistan was suspended from the Commonwealth at the time, so no Commonwealth group observed.","quotes":[{"who":"EU Election Observation Mission","when":"Final report, April 2008","q":"a level playing field was not provided during the campaign","url":"http://www.eods.eu/library/eu_eom_pakistan_final_report.pdf"},{"who":"Democracy International","when":"US observation mission, 2008","q":"the elections provided a genuine opportunity for Pakistani voters to express their will","url":"https://democracyinternational.com/media/U.S.%20Election%20Observation%20Mission%20to%20Pakistan%20General%20Elections%202008%20Final%20Report.pdf"}]},"2013":{"date":"11 May 2013","polled":"269 of 272","postponed":"3 seats did not poll","turnout":"55%","cands":"4,496","tight":"52","summary":"The first time an elected civilian government in Pakistan completed its term and handed power to another. Turnout was the highest since 1977. The campaign was not equally free: the Pakistani Taliban attacked the three outgoing coalition parties — ANP, MQM and PPP — while their opponents campaigned openly. PTI alleged rigging in four constituencies; a three-judge commission examined the claims in 2015. Around 500 polling stations recorded no women voting at all.","quotes":[{"who":"EU Election Observation Mission","when":"Final report, 2013","q":"The high number of attacks affected campaigning and unbalanced the playing field","url":"https://www.eeas.europa.eu/sites/default/files/pakistan_eom_final_report_eng_1.pdf"},{"who":"Judicial Commission of inquiry","when":"Three Supreme Court judges, July 2015","q":"in large part organised and conducted fairly and in accordance with the law","url":"https://www.dawn.com/news/1195875"}]},"2018":{"date":"25 July 2018","polled":"270 of 272","postponed":"2 seats did not poll","turnout":"52%","cands":"3,431","tight":"79","summary":"Nawaz Sharif was disqualified from office for life in April and jailed twelve days before the poll. Some 370,000 troops were deployed, many stationed inside polling stations and given magisterial powers. On election night the Election Commission's new Result Transmission System collapsed and results ran days late. Observers drew a sharp line between the campaign, which they criticised heavily, and the conduct of voting itself, which they largely praised — while faulting the count.","quotes":[{"who":"EU Election Observation Mission","when":"Final report, October 2018","q":"There was no level playing field for electoral contestants","url":"https://www.eods.eu/library/final_report_pakistan_2018_english.pdf"},{"who":"EU Election Observation Mission","when":"On polling day itself","q":"Voting was assessed as well-conducted and transparent","url":"https://www.eods.eu/library/final_report_pakistan_2018_english.pdf"},{"who":"Human Rights Commission of Pakistan","when":"Pre-poll statement, 16 July 2018","q":"blatant, aggressive and unabashed attempts to manipulate the outcome","url":"https://hrcp-web.org/hrcpweb/attempts-to-maneuver-polls-unacceptable-hrcp/"}]},"2024":{"date":"8 February 2024","polled":"265 of 266","postponed":"NA-8 Bajaur postponed","turnout":"48%","cands":"5,112","tight":"68","summary":"The Supreme Court stripped PTI of its bat symbol on 13 January; its candidates contested as independents under individual symbols, which is how the returns record them. Polling in NA-8 Bajaur was called off after a candidate was shot dead. Mobile networks were shut down nationwide on polling day, results came roughly fifteen hours past the legal deadline, and the gap between polling-station Form 45s and consolidated Form 47s became the central dispute. The EU sent only a small expert mission, whose report has never been published.","quotes":[{"who":"European Union","when":"High Representative, 9 February 2024","q":"We regret the lack of a level playing field","url":"https://www.consilium.europa.eu/en/press/press-releases/2024/02/09/pakistan-statement-by-the-high-representative-on-behalf-of-the-european-union-on-the-general-elections/"},{"who":"Commonwealth Observer Group","when":"Final report, published September 2025","q":"impinged on the credibility, transparency and inclusiveness of the electoral process","url":"https://thecommonwealth.org/news/cog-releases-final-report-pakistan-2024-general-elections"},{"who":"Human Rights Commission of Pakistan","when":"Election report, February 2024","q":"The integrity of the 2024 elections was compromised","url":"https://www.thenews.com.pk/print/1158869-hrcp-releases-2024-election-report-demands-independent-audit"}]},"2002":{"date":"10 October 2002","polled":"270 of 272","postponed":"NA-262 and NA-263 re-polled in November","turnout":"42%","cands":"2,049","tight":"59","summary":"Parliament had been dissolved after the coup of 12 October 1999; the Supreme Court validated the takeover but required elections within three years. Pervez Musharraf took a five-year presidential term through a referendum in April 2002, then issued the Legal Framework Order in August, amending the constitution before the poll. Candidates were required to hold a bachelor's degree, with madrasa certificates treated as equivalent, and anyone who had twice been prime minister was barred; Benazir Bhutto and Nawaz Sharif were both abroad and did not contest. Separate electorates for religious minorities were abolished and the voting age was lowered from 21 to 18. Polling in NA-262 and NA-263 was re-run in November.","quotes":[{"who":"EU Election Observation Mission","when":"Final report, 2002","q":"resulted in serious flaws being inflicted on the electoral process","url":"https://www.eods.eu/library/FR%20PAKISTAN%202002_en.pdf"},{"who":"EU Election Observation Mission","when":"On polling day itself","q":"polling day itself had gone relatively smoothly","url":"https://www.eods.eu/library/FR%20PAKISTAN%202002_en.pdf"},{"who":"National Democratic Institute","when":"Pre-election delegation, 9 September 2002","q":"provides for a very limited transfer of power to elected civilian representatives","url":"https://ndi.org/sites/default/files/1434_pk_election_090902_5.pdf"}]},"1993":{"date":"6 October 1993","polled":"202 of 207","postponed":"5 seats filled at later by-elections","turnout":"41%","cands":"1,405","tight":"55","summary":"President Ghulam Ishaq Khan dismissed Nawaz Sharif's government in April 1993 under Article 58(2)(b); the Supreme Court reinstated it, and in July the army brokered the resignation of both men. Moeen Qureshi, a former World Bank official with no domestic base, led the caretaker government, which published lists of loan defaulters and tax delinquents and required candidates to declare their own. Around 150,000 troops were deployed and judicial officers replaced civil servants as presiding officers. The MQM boycotted the National Assembly poll while contesting the provincial assemblies, and turnout in Karachi fell to roughly 15 per cent. No party won a majority; Benazir Bhutto formed a coalition on 19 October. A Commonwealth group and an NDI delegation both observed, but neither report is available online.","quotes":[{"who":"Human Rights Watch","when":"World Report 1994","q":"the low voter turnout of 40 percent, and 15 percent in Karachi where a local party enforced a boycott","url":"https://www.refworld.org/reference/annualreport/hrw/1994/en/35752"},{"who":"Dawn","when":"Retrospective, 13 April 2013","q":"The army became the de facto ruler of the country and dominated the administration of the elections.","url":"https://www.dawn.com/news/802238"}]},"1997":{"date":"3 February 1997","polled":"204 of 207","postponed":"3 seats polled later","turnout":"36%","cands":"1,747","tight":"19","summary":"President Farooq Leghari dismissed Benazir Bhutto's government in November 1996 under Article 58(2)(b), citing corruption, extrajudicial killings and interference with the judiciary; the Supreme Court upheld the dissolution in January. Malik Meraj Khalid led the caretaker administration. Turnout was the lowest in any Pakistani general election to that point. PML-N won 135 of the seats polled on the day, close to a two-thirds majority, and Bhutto alleged that officials had inserted extra ballots. Polling in parts of Karachi was disrupted by violence. A Commonwealth observer group attended; its report is not available online.","quotes":[{"who":"International Progress Organization observer team","when":"To the UN Commission on Human Rights, 1997 — findings focused on Karachi","q":"A condition of lawlessness persisted during the whole electoral campaign and on the election day itself.","url":"https://i-p-o.org/pakelect.htm"}]},"1990":{"date":"24 October 1990","polled":"207 of 207","postponed":"4 seats returned unopposed","turnout":"45%","cands":"1,226","tight":"37","summary":"President Ghulam Ishaq Khan dismissed Benazir Bhutto's government on 6 August 1990 under Article 58(2)(b), and appointed Ghulam Mustafa Jatoi — an opposition leader — as caretaker prime minister. The PPP contested inside the People's Democratic Alliance against the Islami Jamhoori Ittehad, and rejected the result as rigged. Twenty-two years later the Supreme Court, deciding the Asghar Khan case, found that an election cell in the Presidency had channelled intelligence funds to favoured candidates against the PPP. Registered electorate and turnout are not recorded per seat in the available returns; four seats were returned unopposed.","quotes":[{"who":"Supreme Court of Pakistan","when":"Asghar Khan case, 19 October 2012","q":"The general election held in the year 1990 was subjected to corruption and corrupt practices.","url":"https://www.dawn.com/news/757862"},{"who":"Supreme Court of Pakistan","when":"on the election cell in the Presidency","q":"provide financial assistance to the favoured candidates","url":"https://www.dawn.com/news/757862"}]}};
function renderElection(){
  const e=ELEC[state.year]; const el=document.getElementById('elecnote'); if(!e||!el) return;
  const q=e.quotes.map(x=>`<div class="eq"><div class="qt">&ldquo;${x.q}&rdquo;</div><div class="qw">${x.who} · <a href="${x.url}" target="_blank" rel="noopener">${x.when}</a></div></div>`).join('');
  el.innerHTML=`<div class="k">This election · ${state.year}</div>
  <div class="estat">
    <div><span>Seats polled</span><b>${e.polled}</b></div>
    <div><span>Turnout</span><b>${e.turnout}</b></div>
    <div><span>Candidates</span><b>${e.cands}</b></div>
    <div><span>Won by under 5%</span><b>${e.tight}</b></div>
  </div>
  <div class="ebody">
    <div><p class="esum">${e.summary}</p><div class="emore"><a href="method.html#elections">Full account, with sources &rarr;</a></div></div>
    <div><div class="k" style="margin-bottom:8px">What observers said</div>${q}</div>
  </div>`;
}
